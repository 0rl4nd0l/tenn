#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
if command -v realpath >/dev/null 2>&1; then
  script_path="$(realpath "${script_path}")"
elif command -v readlink >/dev/null 2>&1; then
  # readlink -f is supported on Linux
  script_path="$(readlink -f "${script_path}" 2>/dev/null || echo "${script_path}")"
fi

REPO_ROOT="$(cd "$(dirname "${script_path}")/.." && pwd)"
CONFIG_FILE="${REPO_ROOT}/scripts/start_config.env"

if [[ ! -f "${CONFIG_FILE}" ]]; then
  echo "ERROR: missing config: ${CONFIG_FILE}" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "${CONFIG_FILE}"

usage() {
  cat <<'EOF'
Usage:
  cockpit start          Start full stack + terminal TUI
  cockpit start web      Start full stack + web UI (browser)
  cockpit start new      Start full stack + Next.js cockpit UI (browser, default port 8081)
  cockpit stop
  cockpit status
  cockpit logs
  cockpit kill backend
  cockpit kill root      Stop all local Cockpit UI processes (web port + TUI/web PIDs)
  cockpit restart backend
  cockpit doctor
  cockpit bugagent       Start bug monitor web UI (http://localhost:8765)

Config:
  Edit: scripts/start_config.env
EOF
}

cmd="${1:-}"
shift || true

if [[ -z "${cmd}" || "${cmd}" == "-h" || "${cmd}" == "--help" ]]; then
  usage
  exit 0
fi

ENGINE_ROOT="${ENGINE_ROOT:?ENGINE_ROOT missing (scripts/start_config.env)}"
COMPOSE_FILE="${COMPOSE_FILE:?COMPOSE_FILE missing (scripts/start_config.env)}"

COMPOSE_ENV_PATH="${COMPOSE_ENV_FILE:-.env}"
if [[ "${COMPOSE_ENV_PATH}" != /* ]]; then
  COMPOSE_ENV_PATH="${ENGINE_ROOT}/${COMPOSE_ENV_PATH}"
fi

# Source .env into the shell so cockpit (and its launcher functions) inherit
# API keys and endpoint URLs.  Only set vars that are not already in the
# environment — existing shell exports take precedence (same semantics as
# python-dotenv override=False).
if [[ -f "${COMPOSE_ENV_PATH}" ]]; then
  while IFS= read -r _line || [[ -n "${_line}" ]]; do
    _line="${_line%%#*}"          # strip comments
    _line="${_line#"${_line%%[! ]*}"}"  # strip leading whitespace
    [[ -z "${_line}" || "${_line}" != *=* ]] && continue
    _key="${_line%%=*}"
    _val="${_line#*=}"
    _key="${_key#"${_key%%[! ]*}"}"   # trim key
    _key="${_key%"${_key##*[! ]}"}"
    _val="${_val#"${_val%%[! ]*}"}"   # trim value
    _val="${_val%"${_val##*[! ]}"}"
    if [[ -n "${_key}" && -z "${!_key+x}" ]]; then
      export "${_key}=${_val}"
    fi
  done < "${COMPOSE_ENV_PATH}"
  unset _line _key _val
fi

COMPOSE=(docker compose --env-file "${COMPOSE_ENV_PATH}" -f "${COMPOSE_FILE}")
if [[ -n "${COMPOSE_EXTRA_ARGS:-}" ]]; then
  # shellcheck disable=SC2206
  COMPOSE+=(${COMPOSE_EXTRA_ARGS})
fi

# Kill every host-side Cockpit UI process so a new `cockpit start` / `cockpit start web`
# can bind (e.g. port 8081). Does not run `docker compose down`; use `cockpit stop` for that.
cockpit_kill_root() {
  local any=0
  local -a ports=()
  local port port_pids

  ports+=("${COCKPIT_WEB_PORT:-8081}")
  ports+=("${COCKPIT_NEW_PORT:-${COCKPIT_WEB_PORT:-8081}}")

  if command -v lsof >/dev/null 2>&1; then
    for port in "${ports[@]}"; do
      port_pids="$(lsof -ti "tcp:${port}" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//' || true)"
      if [[ -n "${port_pids// /}" ]]; then
        echo "Freeing Cockpit UI port ${port} (PIDs: ${port_pids})…"
        # shellcheck disable=SC2086
        kill ${port_pids} 2>/dev/null || sudo kill ${port_pids} 2>/dev/null || true
        any=1
        sleep 0.3
      fi
    done
  else
    echo "WARN: lsof not found; cannot free Cockpit UI ports by listener. Install lsof or kill the process manually." >&2
  fi

  local patterns=(
    "${ENGINE_ROOT}/scripts/cockpit_web\\.py"
    "${ENGINE_ROOT}/scripts/cockpit_tui\\.py"
    "${REPO_ROOT}/cockpit-ui.*pnpm start --port"
    "next start --port ${COCKPIT_NEW_PORT:-${COCKPIT_WEB_PORT:-8081}}"
    "next start --port ${COCKPIT_WEB_PORT:-8081}"
  )
  local pat pids
  for pat in "${patterns[@]}"; do
    pids="$(pgrep -f "${pat}" 2>/dev/null || true)"
    if [[ -n "${pids}" ]]; then
      echo "Killing Cockpit launcher matching ${pat} (PIDs: ${pids//$'\n'/ })…"
      # shellcheck disable=SC2086
      kill ${pids} 2>/dev/null || sudo kill ${pids} 2>/dev/null || true
      any=1
    fi
  done

  if [[ "${any}" -eq 0 ]]; then
    echo "No local Cockpit UI processes found (ports clear, no cockpit_web/tui/Next.js PIDs)."
  else
    echo "Done. (Docker stack unchanged — run 'cockpit stop' to tear down compose services.)"
  fi
}

port_in_use() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -ti "tcp:${port}" >/dev/null 2>&1
    return $?
  fi
  if command -v ss >/dev/null 2>&1; then
    ss -ltn "( sport = :${port} )" 2>/dev/null | grep -q ":${port}"
    return $?
  fi
  return 1
}

ensure_ui_port_available() {
  local port="$1"
  if ! port_in_use "${port}"; then
    return 0
  fi
  echo "Port ${port} is already in use. Cleaning up stale Cockpit UI processes..."
  cockpit_kill_root
  if port_in_use "${port}"; then
    echo "ERROR: port ${port} is still in use after cleanup. Check 'lsof -i :${port}'." >&2
    exit 1
  fi
}

python_cmd() {
  if [[ -x "${ENGINE_ROOT}/.venv/bin/python" ]]; then
    echo "${ENGINE_ROOT}/.venv/bin/python"
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    command -v python3
    return 0
  fi
  echo "ERROR: python3 missing" >&2
  exit 1
}

http_ok() {
  local url="$1"
  local timeout_s="${2:-3}"
  local api_key="${3:-}"
  if [[ -n "${api_key}" ]]; then
    curl -fsS -m "${timeout_s}" -H "Authorization: Bearer ${api_key}" "${url}" >/dev/null 2>&1
    return $?
  fi
  curl -fsS -m "${timeout_s}" "${url}" >/dev/null 2>&1
}

llama_api_key() {
  echo "${LLAMACPP_API_KEY:-${LLM_API_KEY:-local-openai-key}}"
}

llama_log_path() {
  local port="$1"
  echo "/tmp/llama-server-${port}.log"
}

base_from_url() {
  local raw="$1"
  raw="${raw%%/v1/models}"
  raw="${raw%%/v1}"
  raw="${raw%%/}"
  echo "${raw}"
}

backend_health_url() {
  echo "${COCKPIT_BACKEND_URL:-http://127.0.0.1:8000}/api/health"
}

llama_chat_base_url() {
  local raw="${COCKPIT_LLAMACPP_URL:-${LLAMACPP_URL_HOST:-${LLAMACPP_URL:-http://127.0.0.1:8001/v1}}}"
  base_from_url "${raw}"
}

llama_extraction_base_url() {
  # Default to sharing the chat server unless a dedicated extraction URL is explicitly
  # configured. This keeps the stack on a single llama.cpp process by default while
  # still allowing an opt-in second server for heavy extraction workloads.
  local raw="${EXTRACTION_LLAMACPP_URL:-}"
  if [[ -z "${raw}" ]]; then
    raw="$(llama_chat_base_url)"
  fi
  base_from_url "${raw}"
}

wait_for_health() {
  local name="$1"
  local url="$2"
  local timeout_s="${3:-60}"
  local log_path="${4:-}"
  local api_key="${5:-}"
  local deadline=$(( $(date +%s) + timeout_s ))
  while true; do
    if http_ok "${url}" 3 "${api_key}"; then
      echo "✅ ${name} healthy: ${url}"
      return 0
    fi
    if [[ "$(date +%s)" -ge "${deadline}" ]]; then
      echo "ERROR: ${name} did not become healthy within ${timeout_s}s (${url})" >&2
      if [[ -n "${log_path}" ]]; then
        echo "See log: ${log_path}" >&2
      fi
      return 1
    fi
    sleep 1
  done
}

ensure_llama_servers_up() {
  local chat_base extraction_base extraction_enabled extraction_distinct api_key chat_log extraction_log
  chat_base="$(llama_chat_base_url)"
  extraction_base="$(llama_extraction_base_url)"
  extraction_enabled="${ENABLE_EXTRACTION_ON_STARTUP:-true}"
  extraction_distinct="true"
  if [[ "${extraction_base}" == "${chat_base}" ]]; then
    extraction_distinct="false"
  fi
  api_key="$(llama_api_key)"
  chat_log="$(llama_log_path "${chat_base##*:}")"
  extraction_log="$(llama_log_path "${extraction_base##*:}")"

  if http_ok "${chat_base}/health" 3 "${api_key}"; then
    echo "✅ llama.cpp chat already running (${chat_base})"
  else
    echo "Starting llama.cpp chat server on ${chat_base} (log: ${chat_log})..."
    (
      cd "${REPO_ROOT}" &&
      setsid -f bash -lc "cd '${REPO_ROOT}' && exec bash scripts/run_llama_server.sh >>'${chat_log}' 2>&1 </dev/null"
    )
  fi

  if [[ "${extraction_enabled}" == "true" || "${extraction_enabled}" == "1" ]] && [[ "${extraction_distinct}" == "true" ]]; then
    if http_ok "${extraction_base}/health" 3 "${api_key}"; then
      echo "✅ llama.cpp extraction already running (${extraction_base})"
    else
      echo "Starting llama.cpp extraction server on ${extraction_base} (log: ${extraction_log})..."
      (
        cd "${REPO_ROOT}" &&
        setsid -f bash -lc "cd '${REPO_ROOT}' && exec bash scripts/run_extraction_server.sh >>'${extraction_log}' 2>&1 </dev/null"
      )
    fi
  else
    if [[ "${extraction_distinct}" == "false" ]]; then
      echo "ℹ️  Extraction server startup skipped (sharing chat server at ${chat_base})"
    else
      echo "ℹ️  Extraction server startup skipped (ENABLE_EXTRACTION_ON_STARTUP=${extraction_enabled})"
    fi
  fi

  wait_for_health "llama.cpp chat" "${chat_base}/health" 120 "${chat_log}" "${api_key}"
  if [[ "${extraction_enabled}" == "true" || "${extraction_enabled}" == "1" ]] && [[ "${extraction_distinct}" == "true" ]]; then
    wait_for_health "llama.cpp extraction" "${extraction_base}/health" 120 "${extraction_log}" "${api_key}"
  fi
}

stop_llama_servers() {
  local chat_base extraction_base chat_port extraction_port pids
  chat_base="$(llama_chat_base_url)"
  extraction_base="$(llama_extraction_base_url)"
  chat_port="${chat_base##*:}"
  extraction_port="${extraction_base##*:}"

  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user stop llama-cpp-qwen25.service >/dev/null 2>&1 || true
  fi

  pids="$(pgrep -f "llama-server.*--port ${chat_port}\\b" || true)"
  if [[ -n "${pids}" ]]; then
    echo "Stopping llama.cpp chat (port ${chat_port}, PID ${pids//$'\n'/ })..."
    if ! kill ${pids} 2>/dev/null; then
      echo "WARN: unable to kill llama.cpp chat PIDs without elevated privileges." >&2
    fi
  else
    echo "No llama.cpp chat server found on port ${chat_port}."
  fi

  pids="$(pgrep -f "llama-server.*--port ${extraction_port}\\b" || true)"
  if [[ -n "${pids}" ]]; then
    echo "Stopping llama.cpp extraction (port ${extraction_port}, PID ${pids//$'\n'/ })..."
    if ! kill ${pids} 2>/dev/null; then
      echo "WARN: unable to kill llama.cpp extraction PIDs without elevated privileges." >&2
    fi
  else
    echo "No llama.cpp extraction server found on port ${extraction_port}."
  fi
}

stop_backend_api() {
  local pids stopped_via_compose
  stopped_via_compose=0

  if (cd "${ENGINE_ROOT}" && "${COMPOSE[@]}" ps backend >/dev/null 2>&1); then
    if (cd "${ENGINE_ROOT}" && "${COMPOSE[@]}" stop backend >/dev/null 2>&1); then
      echo "Stopped backend service via docker compose."
      stopped_via_compose=1
    fi
  fi

  # Fallback for non-docker uvicorn backend processes.
  pids="$(pgrep -f "uvicorn app.main:app" || true)"
  if [[ -n "${pids}" ]]; then
    echo "Stopping local backend API process (PID ${pids//$'\n'/ })..."
    if ! kill ${pids} 2>/dev/null; then
      echo "WARN: unable to kill local backend PID(s) without elevated privileges." >&2
    fi
    return 0
  fi

  if [[ "${stopped_via_compose}" -eq 0 ]]; then
    echo "No backend process found."
  fi
}

start_all_backends_safely() {
  if [[ -x "${REPO_ROOT}/scripts/gpu_process_guard.sh" ]]; then
    if ! (cd "${REPO_ROOT}" && scripts/gpu_process_guard.sh --check); then
      echo "ERROR: GPU process guard failed. Resolve rogue/VRAM issues before starting servers." >&2
      return 1
    fi
  fi
  ensure_llama_servers_up
}

kill_backend_stack() {
  stop_backend_api
  stop_llama_servers
}

launch_cockpit_tui() {
  local py
  py="$(python_cmd)"

  local cfg="${COCKPIT_CONFIG:-config/cockpit.yaml}"
  if [[ "${cfg}" != /* ]]; then
    cfg="${ENGINE_ROOT}/${cfg}"
  fi

  echo "config: ${cfg}"

  local profile="${COCKPIT_PROFILE:-default}"
  local no_boot_flag="--no-boot"

  # Isolate cockpit to its own OpenViking workspace (operator override via OPENVIKING_CONFIG_FILE)
  if [[ -z "${OPENVIKING_CONFIG_FILE:-}" ]]; then
    export OPENVIKING_CONFIG_FILE="${HOME}/.openviking/cockpit.ov.conf"
  fi

  local launcher="${ENGINE_ROOT}/scripts/cockpit_tui.py"
  if [[ ! -f "${launcher}" ]]; then
    echo "ERROR: cockpit launcher not found: ${launcher}" >&2
    exit 1
  fi

  local cockpit_cmd=("${py}" "${launcher}" "${no_boot_flag}" --cockpit-config "" -- --config "${cfg}" --profile "${profile}")

  run_with_pseudo_tty() {
    local term_value="xterm-256color"
    # Use a Python PTY wrapper so `cockpit_tui.py` sees a real TTY and TERM is valid.
    "${py}" -c '
import os, pty, sys, select
term = sys.argv[1]
cmd = sys.argv[2:]
env = os.environ.copy()
env["TERM"] = term

pid, fd = pty.fork()
if pid == 0:
    os.execvpe(cmd[0], cmd, env)

stdin_fd = sys.stdin.fileno()
out_fd = sys.stdout.fileno()

while True:
    r, _, _ = select.select([fd, stdin_fd], [], [])
    if fd in r:
        try:
            data = os.read(fd, 1024)
        except OSError:
            break
        if not data:
            break
        os.write(out_fd, data)
    if stdin_fd in r:
        try:
            data = os.read(stdin_fd, 1024)
        except OSError:
            break
        if not data:
            break
        os.write(fd, data)

os.waitpid(pid, 0)
' "${term_value}" "${cockpit_cmd[@]}"
  }

  case "${TERMINAL_MODE:-auto}" in
    tmux)
      if [[ -z "${TMUX:-}" ]]; then
        echo "ERROR: TERMINAL_MODE=tmux but not in tmux" >&2
        exit 1
      fi
      tmux split-window -v "${cockpit_cmd[*]}"
      ;;
    gnome-terminal)
      command -v gnome-terminal >/dev/null 2>&1 || { echo "ERROR: gnome-terminal missing"; exit 1; }
      gnome-terminal -- bash -lc "${cockpit_cmd[*]}" || {
        echo "⚠️  gnome-terminal failed; running Cockpit in foreground" >&2
        run_with_pseudo_tty
      }
      ;;
    foreground)
      run_with_pseudo_tty
      ;;
    auto)
      if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
        tmux split-window -v "${cockpit_cmd[*]}"
      elif command -v gnome-terminal >/dev/null 2>&1; then
        gnome-terminal -- bash -lc "${cockpit_cmd[*]}" || {
          echo "⚠️  gnome-terminal failed; running Cockpit in foreground" >&2
          run_with_pseudo_tty
        }
      elif command -v x-terminal-emulator >/dev/null 2>&1; then
        x-terminal-emulator -e bash -lc "${cockpit_cmd[*]}"
      else
        run_with_pseudo_tty
      fi
      ;;
    *)
      echo "ERROR: unknown TERMINAL_MODE=${TERMINAL_MODE}" >&2
      exit 1
      ;;
  esac
}

launch_cockpit_web() {
  local py
  py="$(python_cmd)"

  # Resolve textual CLI from the same venv as python.
  local venv_dir
  venv_dir="$(dirname "${py}")"
  local textual_bin="${venv_dir}/textual"
  if [[ ! -x "${textual_bin}" ]]; then
    echo "ERROR: textual CLI not found at ${textual_bin}." >&2
    echo "       Install it with: pip install textual-dev" >&2
    exit 1
  fi

  local cfg="${COCKPIT_CONFIG:-config/cockpit.yaml}"
  if [[ "${cfg}" != /* ]]; then
    cfg="${ENGINE_ROOT}/${cfg}"
  fi

  local backend_url="${COCKPIT_BACKEND_URL:-http://localhost:8000}"
  local ollama_url="${OLLAMA_URL:-http://localhost:11434}"
  local port="${COCKPIT_WEB_PORT:-8081}"
  local launcher="${ENGINE_ROOT}/scripts/cockpit_web.py"
  if [[ ! -f "${launcher}" ]]; then
    echo "ERROR: cockpit web launcher not found: ${launcher}" >&2
    exit 1
  fi

  # Isolate cockpit to its own OpenViking workspace (operator override via OPENVIKING_CONFIG_FILE)
  if [[ -z "${OPENVIKING_CONFIG_FILE:-}" ]]; then
    export OPENVIKING_CONFIG_FILE="${HOME}/.openviking/cockpit.ov.conf"
  fi

  export COCKPIT_CONFIG="${cfg}"
  export COCKPIT_BACKEND_URL="${backend_url}"
  export OLLAMA_URL="${ollama_url}"
  export COCKPIT_LLAMACPP_URL="${COCKPIT_LLAMACPP_URL:-${LLAMACPP_URL_HOST:-${LLAMACPP_URL:-http://localhost:8001}}}"

  ensure_ui_port_available "${port}"
  echo "Starting Cockpit web UI on http://localhost:${port}"
  echo "Open that URL in your browser."
  (cd "${ENGINE_ROOT}" && "${textual_bin}" serve --port "${port}" -c "${py} ${launcher}")
}

launch_cockpit_new() {
  if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: node is not installed or not in PATH" >&2
    exit 1
  fi
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "ERROR: pnpm is not installed or not in PATH" >&2
    exit 1
  fi

  local cockpit_ui_dir="${REPO_ROOT}/cockpit-ui"
  local port="${COCKPIT_NEW_PORT:-${COCKPIT_WEB_PORT:-8081}}"

  export NEXT_PUBLIC_API_URL="${COCKPIT_BACKEND_URL:-http://localhost:8000}"

  if [[ ! -d "${cockpit_ui_dir}/node_modules" ]]; then
    echo "Installing dependencies (pnpm install)..."
    (cd "${cockpit_ui_dir}" && pnpm install)
  fi

  echo "Building Cockpit UI..."
  (cd "${cockpit_ui_dir}" && pnpm build)
  ensure_ui_port_available "${port}"
  echo "Cockpit UI (Next.js) → http://localhost:${port}"
  (cd "${cockpit_ui_dir}" && pnpm start --port "${port}")
}

case "${cmd}" in
  start)
    sub="${1:-}"
    shift || true
    if [[ "${sub}" == "web" ]]; then
      "${REPO_ROOT}/scripts/start_full_stack.sh"
      start_all_backends_safely
      launch_cockpit_web
    elif [[ "${sub}" == "new" ]]; then
      "${REPO_ROOT}/scripts/start_full_stack.sh"
      start_all_backends_safely
      launch_cockpit_new
    else
      "${REPO_ROOT}/scripts/start_full_stack.sh"
      start_all_backends_safely
      launch_cockpit_tui
    fi
    ;;
  stop)
    (cd "${ENGINE_ROOT}" && "${COMPOSE[@]}" down)
    ;;
  status)
    (cd "${ENGINE_ROOT}" && "${COMPOSE[@]}" ps)
    ;;
  logs)
    svc="${LOGS_SERVICE:-}"
    if [[ -n "${svc}" ]]; then
      (cd "${ENGINE_ROOT}" && "${COMPOSE[@]}" logs -f "${svc}")
    else
      (cd "${ENGINE_ROOT}" && "${COMPOSE[@]}" logs -f)
    fi
    ;;
  doctor)
    "${REPO_ROOT}/scripts/cockpit_doctor.sh"
    ;;
  kill)
    svc="${1:-}"
    case "${svc}" in
      backend)
        kill_backend_stack
        echo "Done."
        ;;
      root | all)
        cockpit_kill_root
        ;;
      *)
        echo "Usage: cockpit kill backend | root" >&2
        echo "       (root: free web UI port and cockpit_web/cockpit_tui processes; alias: all)" >&2
        exit 2
        ;;
    esac
    ;;
  restart)
    svc="${1:-}"
    if [[ "${svc}" != "backend" ]]; then
      echo "Usage: cockpit restart backend" >&2
      exit 2
    fi
    kill_backend_stack
    "${REPO_ROOT}/scripts/start_full_stack.sh"
    start_all_backends_safely
    wait_for_health "Backend API" "$(backend_health_url)" 120
    ;;
  bugagent)
    py="$(python_cmd)"
    ui_script="${REPO_ROOT}/.claude/monitors/bug_web_ui.py"
    if [[ ! -f "${ui_script}" ]]; then
      echo "ERROR: bug UI not found: ${ui_script}" >&2
      exit 1
    fi
    # Kill any existing instance on port 8765
    old_pid="$(lsof -ti tcp:8765 2>/dev/null || true)"
    if [[ -n "${old_pid}" ]]; then
      echo "Stopping existing bug UI (PID ${old_pid})…"
      kill "${old_pid}" 2>/dev/null || true
      sleep 0.5
    fi
    echo "Bug Monitor UI → http://localhost:8765"
    exec "${py}" "${ui_script}"
    ;;
  *)
    usage
    exit 2
    ;;
esac
