# Tenn full-stack startup config
#
# This file is sourced by `scripts/start_full_stack.sh` and `scripts/cockpit`.
# Edit values here to change startup behavior deterministically.
#
# =========================
# REQUIRED / COMMON OPTIONS
# =========================
#
# Compose project root (must contain `financial-engine_v2/docker-compose.yml`)
ENGINE_ROOT="/home/l4nd0/tenn/financial-engine_v2"
COMPOSE_FILE="$ENGINE_ROOT/docker-compose.yml"

# Compose env file (relative to ENGINE_ROOT unless absolute)
COMPOSE_ENV_FILE=".env"

# Backend health endpoint (host)
BACKEND_HEALTH_URL="http://127.0.0.1:8000/api/health"

# Host Ollama endpoint (used by doctor + host-side cockpit defaults)
OLLAMA_URL_HOST="http://127.0.0.1:11434"

# Host llama.cpp endpoint (used by doctor + to derive container-facing URL)
LLAMACPP_URL_HOST="http://127.0.0.1:8001/v1"

# Container-facing endpoints for host-provided services.
#
# NOTE: On this machine, `host.docker.internal` does not resolve from inside Docker.
# The working host-gateway path (validated via docker-run curl) is `172.17.0.1`.
# If your environment differs, override these values.
#
# OLLAMA: make host Ollama reachable from containers via the compose gateway.
OLLAMA_URL_CONTAINER="http://172.18.0.1:11434"

# Llama.cpp: optional; leave empty to skip compose-network preflight probes.
LLAMACPP_URL_CONTAINER=""

# Backend readiness timeout (seconds)
BACKEND_START_TIMEOUT="180"

# =========================
# COCKPIT OPTIONS
# =========================
#
# Cockpit config path (relative to ENGINE_ROOT unless absolute)
COCKPIT_CONFIG="config/cockpit.yaml"
COCKPIT_PROFILE="default"

# Always keep Cockpit as a client: never bootstrap infra from Cockpit.
COCKPIT_NO_BOOT="true"

# Full-stack startup feature toggles (override backend `.env`).
# Extraction needs llama.cpp (managed by cockpit). Embeddings need Ollama. Qdrant is the vector store.
ENABLE_EMBEDDINGS_ON_STARTUP="true"
ENABLE_QDRANT_ON_STARTUP="true"
ENABLE_EXTRACTION_ON_STARTUP="true"

# Terminal preference for launching Cockpit:
# - auto: try tmux split if inside tmux, else try gnome-terminal, else x-terminal-emulator, else run in foreground
# - gnome-terminal: force gnome-terminal
# - tmux: force tmux split (requires TMUX)
TERMINAL_MODE="foreground"

# =========================
# ADVANCED OPTIONS
# =========================
#
# Force CPU-only mode (not recommended)
# USE_CPU_ONLY="false"
#
# Override docker compose services list for `cockpit start` (comma-separated)
COMPOSE_SERVICES="postgres,qdrant,backend,worker"
#
# Stream logs target on `cockpit logs` (empty means all services)
# LOGS_SERVICE=""
#
# Extra docker compose args for start/stop/status/logs (space-separated)
# COMPOSE_EXTRA_ARGS=""
