#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
PROXY_HOST="${CLAUDE_LLAMA_PROXY_HOST:-127.0.0.1}"
PROXY_PORT="${CLAUDE_LLAMA_PROXY_PORT:-8745}"
PROXY_URL="http://${PROXY_HOST}:${PROXY_PORT}"
PROXY_HEALTH_URL="${PROXY_URL}/healthz"
PROXY_LOG="${CLAUDE_LLAMA_PROXY_LOG:-/tmp/claude-llama-proxy.log}"

check_proxy() {
  python3 -c 'import json, sys, urllib.request
url = sys.argv[1]
try:
    with urllib.request.urlopen(url, timeout=1.5) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    sys.exit(0 if payload.get("ok") else 1)
except Exception:
    sys.exit(1)
' "$PROXY_HEALTH_URL"
}

if ! check_proxy; then
  nohup python3 "$ROOT_DIR/scripts/claude_llamacpp_proxy.py" \
    --host "$PROXY_HOST" \
    --port "$PROXY_PORT" \
    >>"$PROXY_LOG" 2>&1 &

  for _ in $(seq 1 20); do
    sleep 0.25
    if check_proxy; then
      break
    fi
  done
fi

if ! check_proxy; then
  echo "claude-llama: proxy did not become healthy at ${PROXY_HEALTH_URL}" >&2
  echo "claude-llama: check ${PROXY_LOG} and confirm llama.cpp is reachable" >&2
  exit 1
fi

export ANTHROPIC_BASE_URL="$PROXY_URL"
export ANTHROPIC_API_KEY="${CLAUDE_LLAMA_PROXY_API_KEY:-local-openai-key}"
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-${CLAUDE_LLAMA_UPSTREAM_MODEL:-qwen2.5-coder-14b}}"
unset CLAUDE_CODE_USE_BEDROCK
unset CLAUDE_CODE_USE_VERTEX
unset CLAUDE_CODE_USE_FOUNDRY

exec claude "$@"
