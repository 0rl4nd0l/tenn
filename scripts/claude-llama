#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
LLAMA_SERVER_ENV_FILE="${LLAMA_SERVER_ENV_FILE:-${HOME}/.config/tenn/llama-server.env}"

load_llama_server_defaults() {
  local env_file="$1"
  [[ -f "$env_file" ]] || return 0

  while IFS= read -r line; do
    local key="${line%%=*}"
    local value="${line#*=}"

    [[ "$key" == LLAMA_SERVER_* ]] || continue
    if [[ -z "${!key+x}" ]]; then
      export "$key=$value"
    fi
  done < <(
    bash -c 'set -a; source "$1"; env' bash "$env_file" 2>/dev/null
  )
}

load_llama_server_defaults "$LLAMA_SERVER_ENV_FILE"

PROXY_HOST="${CLAUDE_LLAMA_PROXY_HOST:-127.0.0.1}"
PROXY_PORT="${CLAUDE_LLAMA_PROXY_PORT:-8745}"
PROXY_URL="http://${PROXY_HOST}:${PROXY_PORT}"
PROXY_HEALTH_URL="${PROXY_URL}/healthz"
PROXY_LOG="${CLAUDE_LLAMA_PROXY_LOG:-/tmp/claude-llama-proxy.log}"
UPSTREAM_BASE_URL="${CLAUDE_LLAMA_UPSTREAM_BASE_URL:-http://${LLAMA_SERVER_HOST:-127.0.0.1}:${LLAMA_SERVER_PORT:-8001}/v1}"
UPSTREAM_HEALTH_URL="${UPSTREAM_BASE_URL%/}/models"
UPSTREAM_LOG="${CLAUDE_LLAMA_UPSTREAM_LOG:-/tmp/claude-llama-upstream.log}"
UPSTREAM_API_KEY="${CLAUDE_LLAMA_UPSTREAM_API_KEY:-local-openai-key}"
UPSTREAM_MODEL="${CLAUDE_LLAMA_UPSTREAM_MODEL:-qwen2.5-coder-14b}"
AUTOSTART_UPSTREAM="${CLAUDE_LLAMA_AUTOSTART_UPSTREAM:-1}"

check_proxy() {
  python3 -c 'import json, sys, urllib.request
url = sys.argv[1]
try:
    with urllib.request.urlopen(url, timeout=1.5) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    sys.exit(0 if payload.get("ok") else 1)
except Exception:
    sys.exit(1)
' "$PROXY_HEALTH_URL"
}

check_upstream() {
  python3 -c 'import sys, urllib.request
url = sys.argv[1]
try:
    with urllib.request.urlopen(url, timeout=1.5) as resp:
        sys.exit(0 if resp.status == 200 else 1)
except Exception:
    sys.exit(1)
' "$UPSTREAM_HEALTH_URL"
}

parse_upstream_host_port() {
  python3 -c 'from urllib.parse import urlsplit
import sys
parts = urlsplit(sys.argv[1])
host = parts.hostname or ""
port = parts.port
if not port:
    if parts.scheme == "http":
        port = 80
    elif parts.scheme == "https":
        port = 443
if not host or not port:
    raise SystemExit(1)
print(host)
print(port)
' "$UPSTREAM_BASE_URL"
}

start_upstream() {
  local parsed host port

  if [[ "$AUTOSTART_UPSTREAM" == "0" ]]; then
    return 1
  fi

  if ! parsed="$(parse_upstream_host_port)"; then
    echo "claude-llama: could not parse upstream base URL ${UPSTREAM_BASE_URL}" >&2
    return 1
  fi

  host="$(sed -n '1p' <<<"$parsed")"
  port="$(sed -n '2p' <<<"$parsed")"

  if [[ "$host" != "127.0.0.1" && "$host" != "localhost" ]]; then
    echo "claude-llama: upstream autostart only supports localhost targets, got ${UPSTREAM_BASE_URL}" >&2
    return 1
  fi

  nohup env \
    LLAMA_SERVER_HOST="$host" \
    LLAMA_SERVER_PORT="$port" \
    LLAMA_SERVER_API_KEY="$UPSTREAM_API_KEY" \
    LLAMA_SERVER_ALIAS="$UPSTREAM_MODEL" \
    bash "$ROOT_DIR/scripts/run_llama_server.sh" \
    >>"$UPSTREAM_LOG" 2>&1 &

  for _ in $(seq 1 80); do
    sleep 0.5
    if check_upstream; then
      return 0
    fi
  done

  return 1
}

if ! check_upstream; then
  if ! start_upstream; then
    echo "claude-llama: upstream did not become healthy at ${UPSTREAM_HEALTH_URL}" >&2
    echo "claude-llama: check ${UPSTREAM_LOG} and confirm the model is available" >&2
    exit 1
  fi
fi

if ! check_proxy; then
  nohup python3 "$ROOT_DIR/scripts/claude_llamacpp_proxy.py" \
    --host "$PROXY_HOST" \
    --port "$PROXY_PORT" \
    --upstream-base-url "$UPSTREAM_BASE_URL" \
    --upstream-api-key "$UPSTREAM_API_KEY" \
    --upstream-model "$UPSTREAM_MODEL" \
    >>"$PROXY_LOG" 2>&1 &

  for _ in $(seq 1 20); do
    sleep 0.25
    if check_proxy; then
      break
    fi
  done
fi

if ! check_proxy; then
  echo "claude-llama: proxy did not become healthy at ${PROXY_HEALTH_URL}" >&2
  echo "claude-llama: check ${PROXY_LOG} and confirm llama.cpp is reachable" >&2
  exit 1
fi

export ANTHROPIC_BASE_URL="$PROXY_URL"
export ANTHROPIC_API_KEY="${CLAUDE_LLAMA_PROXY_API_KEY:-$UPSTREAM_API_KEY}"
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-$UPSTREAM_MODEL}"
unset CLAUDE_CODE_USE_BEDROCK
unset CLAUDE_CODE_USE_VERTEX
unset CLAUDE_CODE_USE_FOUNDRY

exec claude "$@"
