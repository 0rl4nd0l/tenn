{
  "storage": {
    "workspace": "~/.openviking/workspaces/cockpit"
  },
  "vlm": {
    "provider": "openai",
    "model": "qwen3-30b-a3b-instruct",
    "api_key": "local-openai-key",
    "api_base": "http://127.0.0.1:8001/v1"
  },
  "embedding": {
    "dense": {
      "provider": "ollama",
      "model": "nomic-embed-text",
      "api_base": "http://127.0.0.1:11434/v1",
      "dimension": 768
    }
  }
}
