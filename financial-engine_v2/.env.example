# Active runtime env file for financial-engine_v2.
# Copy to financial-engine_v2/.env and override only what you need.
#
# Canonical port assignments (single source of truth):
#   8000  backend API (FastAPI/uvicorn)          $PORT
#   8001  llama.cpp LLM server (chat/coding)      $LLAMACPP_URL
#   8002  llama.cpp LLM server (extraction)      $EXTRACTION_LLAMACPP_URL (optional)
#   8081  OpenBB sidecar (optional)              $OPENBB_SIDECAR_BASE_URL
#   6333  Qdrant vector store                    $QDRANT_URL
#   6379  Redis broker/cache                     $REDIS_URL
#   5432  PostgreSQL                             $DATABASE_URL
#  11434  Ollama (embeddings)                    $OLLAMA_URL

DATA_ROOT=./data
PORT=8000
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_URL=http://127.0.0.1:11434
LLM_URL=http://127.0.0.1:8001
LLAMACPP_URL=http://127.0.0.1:8001
# Uncomment to run extraction on a separate llama.cpp instance (recommended):
# EXTRACTION_LLAMACPP_URL=http://127.0.0.1:8002
# EXTRACT_MODEL=qwen2.5-14b-instruct
LLM_API_KEY=local-openai-key
EMBEDDING_BATCH_SIZE=32
ROUTER_FEEDBACK_ENABLED=true
ANALYZER_MAX_AGE_SECONDS=600
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Cockpit chat mode: keyword (default — regex router) or structured (agentic tool-calling loop)
COCKPIT_AGENT_MODE=keyword
# Cockpit HybridRouter policy: local_only (default) | local_preferred | api_preferred | api_only
# The router never calls a cloud API unless an api_client is configured AND the policy allows it.
# HYBRID_ROUTER_POLICY=local_only

# Anthropic API key — used by AnthropicClient (cockpit/core/agent/anthropic_client.py)
# Required only when HYBRID_ROUTER_POLICY=api_preferred or api_only
# ANTHROPIC_API_KEY=sk-ant-...

# Session memory (OpenViking) — enabled by default; isolated per domain:
#   backend default: ~/.openviking/backend.ov.conf  (set by run_local_backend.sh)
#   cockpit default: ~/.openviking/cockpit.ov.conf  (set by scripts/cockpit)
#   claude-code:     source scripts/openviking/export-claude-code-memory-env.sh
# Copy config/openviking/backend.ov.conf.example to the path above to activate.
# Override: OPENVIKING_CONFIG_FILE=/absolute/path/to/your.ov.conf
# Disable:  ENABLE_SESSION_MEMORY=false
