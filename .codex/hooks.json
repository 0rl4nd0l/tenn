{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_job_hook.py\" --platform codex --event BeforeTool --repo-root \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "Checking Tenn V2 task admission..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"systemMessage\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_job_hook.py\" --platform codex --event Stop --repo-root \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "Checking Tenn task card..."
          }
        ]
      }
    ]
  }
}
