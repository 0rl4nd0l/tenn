{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_job_hook.py\" --platform codex --event BeforeTool --repo-root \"$(git rev-parse --show-toplevel)\"",
            "statusMessage": "Checking opted-in Tenn V2 boundaries..."
          }
        ]
      }
    ]
  }
}
