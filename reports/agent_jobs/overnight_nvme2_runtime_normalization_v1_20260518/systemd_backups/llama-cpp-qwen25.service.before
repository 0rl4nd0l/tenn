[Unit]
Description=llama.cpp server (router mode — Qwen3-30B-A3B default)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/tenn/llama-server.env
WorkingDirectory=/home/l4nd0/tenn
ExecStart=/home/l4nd0/tenn/scripts/run_llama_server.sh
Restart=on-failure
RestartSec=15
StartLimitBurst=3
StartLimitIntervalSec=120
MemoryMax=12G
LimitNOFILE=65535

[Install]
WantedBy=default.target
