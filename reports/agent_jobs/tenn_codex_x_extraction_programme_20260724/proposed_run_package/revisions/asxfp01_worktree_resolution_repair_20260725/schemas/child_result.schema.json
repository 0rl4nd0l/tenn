{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex X Child Result Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "ticket_id",
    "run_id",
    "session_id",
    "prompt_hash",
    "allowed_scope",
    "started_at",
    "ended_at",
    "output",
    "result_hash",
    "outcome"
  ],
  "properties": {
    "role": {"const": "IMPLEMENTER"},
    "ticket_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"},
    "run_id": {"type": "string", "pattern": "^\\d{8}T\\d{6}Z-[0-9a-f]{10}-[0-9a-f]{6}$"},
    "session_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "hash"],
      "properties": {
        "kind": {"enum": ["commit", "patch", "none"]},
        "reference": {"type": "string"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["SUCCEEDED", "FAILED"]}
  }
}
