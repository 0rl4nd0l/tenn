# Tenn llama.cpp — single-instance router mode on port 8001.
# All GGUFs served from NVMe; one model loaded at a time (--models-max 1).
# Clients select model per-request via the "model" field in the API body.
LLAMA_SERVER_ROUTER_MODE=1
LLAMA_SERVER_MODELS_DIR=/mnt/nvme/tenn/models
LLAMA_SERVER_HOST=0.0.0.0
LLAMA_SERVER_PORT=8001
LLAMA_SERVER_PRESET=/home/l4nd0/.config/tenn/llamacpp-presets.ini
# Expose only the Tesla M40 to CUDA. Index 0 on this host is the GT 1030 (2 GiB);
# index 1 is the M40 24GB — using 0 made llama.cpp fall back to CPU + huge RAM.
LLAMA_SERVER_CUDA_VISIBLE_DEVICES=0
LLAMA_SERVER_MMAP=0
# Default model (used when single-model fallback is active).
LLAMA_SERVER_MODEL=/mnt/ssd/log/ssd_data/l4nd0_cache/.cache/llmfit/models/gpt-oss-20b-mxfp4.gguf
LLAMA_SERVER_ALIAS=model:gpt-oss-20b
# Legacy extraction overrides (only used if run_extraction_server.sh is started manually).
EXTRACTION_SERVER_MODEL=/mnt/nvme/tenn/models/qwen2.5-14b-instruct-q4_k_m.gguf
EXTRACTION_SERVER_ALIAS=qwen2.5-14b-instruct
EXTRACTION_SERVER_PORT=8002
