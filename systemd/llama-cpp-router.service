[Unit]
Description=llama.cpp server (router mode)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/tenn-nvme2 /mnt/nvme /home/l4nd0/tenn-runtime
StartLimitBurst=3
StartLimitIntervalSec=120

[Service]
Type=simple
EnvironmentFile=-%h/.config/tenn/llama-server.env
WorkingDirectory=/home/l4nd0/tenn-runtime
ExecStart=/home/l4nd0/tenn-runtime/scripts/run_llama_server.sh
Restart=on-failure
RestartSec=15
MemoryMax=12G
LimitNOFILE=65535

[Install]
WantedBy=default.target
