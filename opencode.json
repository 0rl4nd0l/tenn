{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "build",
  "instructions": [
    "CLAUDE.md",
    "AGENTS.md",
    "docs/architecture/SYSTEM_CONTRACT.md"
