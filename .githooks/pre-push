#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
while IFS= read -r git_env_var; do
  unset "$git_env_var"
done < <(git rev-parse --local-env-vars)
cd "$ROOT"

VENV="$ROOT/financial-engine_v2/.venv"
RUFF="$VENV/bin/ruff"
PYTEST="$VENV/bin/pytest"

mapfile -t changed_python < <(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$' || true)
if [[ "${#changed_python[@]}" -gt 0 && -x "$RUFF" ]]; then
  echo "[pre-push] changed-file ruff check..." >&2
  "$RUFF" check "${changed_python[@]}"
elif [[ "${#changed_python[@]}" -gt 0 ]]; then
  echo "[pre-push] ruff unavailable; CI remains the full-suite gate" >&2
fi

if [[ ! -x "$PYTEST" ]]; then
  echo "[pre-push] pytest unavailable; skipping local tests without blocking push" >&2
fi

if [[ -f scripts/check_markdown_hygiene.sh ]]; then
  echo "[pre-push] markdown hygiene..."
  bash scripts/check_markdown_hygiene.sh
fi
