#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
while IFS= read -r git_env_var; do
  unset "$git_env_var"
done < <(git rev-parse --local-env-vars)
cd "$ROOT"

ZERO_SHA="0000000000000000000000000000000000000000"
changed_python=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" || "$local_sha" == "$ZERO_SHA" ]] && continue
  if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
    range=("$local_sha")
    names=("git" "diff-tree" "--no-commit-id" "--name-only" "-r" "--diff-filter=ACMR" "${range[@]}")
  else
    names=("git" "diff" "--name-only" "--diff-filter=ACMR" "$remote_sha" "$local_sha")
  fi
  while IFS= read -r path; do
    [[ "$path" == *.py && -f "$path" ]] && changed_python+=("$path")
  done < <("${names[@]}")
done

if [[ "${#changed_python[@]}" -gt 0 ]]; then
  mapfile -t changed_python < <(printf '%s\n' "${changed_python[@]}" | sort -u)
fi
RUFF="$ROOT/financial-engine_v2/.venv/bin/ruff"
if [[ "${#changed_python[@]}" -gt 0 && -x "$RUFF" ]]; then
  echo "[pre-push] changed-file ruff check..." >&2
  "$RUFF" check "${changed_python[@]}"
elif [[ "${#changed_python[@]}" -gt 0 ]]; then
  echo "[pre-push] ruff unavailable; CI remains the full-suite gate" >&2
fi

if [[ -f scripts/check_markdown_hygiene.sh ]]; then
  echo "[pre-push] markdown hygiene..." >&2
  bash scripts/check_markdown_hygiene.sh
fi
